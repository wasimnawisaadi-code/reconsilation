# ── Supabase authentication ─────────────────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Dashboard → Project Settings → API
# 3. Copy this file to `.env.local` (never committed) and paste both values
# 4. Restart the dev server / redeploy
#
# The anon key is a PUBLIC key — it is designed to ship to the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...paste-your-anon-public-key-here
